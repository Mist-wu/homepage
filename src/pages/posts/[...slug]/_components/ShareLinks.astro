---
import QRCode from "qrcode";
import LinkButton from "@/components/LinkButton.astro";
import { tplStr, useTranslations } from "@/i18n";
import config from "@/config";

const { shareLinks } = config;
const t = useTranslations(Astro.currentLocale);

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const pageUrl = Astro.url;

const platformLabel = (name: string) =>
  name.charAt(0).toUpperCase() + name.slice(1);

const items = await Promise.all(
  shareLinks.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const title =
      linkTitle ??
      (name === "mail"
        ? t.post.sharePostViaEmail
        : tplStr(t.post.sharePostOn, { platform: platformLabel(name) }));
    // WeChat can't be shared to via URL, so show a QR code of the post instead
    const qrSvg =
      name === "wechat"
        ? await QRCode.toString(pageUrl.href, { type: "svg", margin: 1 })
        : undefined;
    return { name, url, title, Icon, qrSvg };
  })
);
---

{
  items.some(({ Icon }) => Icon) && (
    <div class="flex flex-none flex-col items-center justify-center gap-1 md:items-start">
      <span class="italic">{t.post.sharePostIntro}</span>
      <div class="text-center">
        {items.map(({ name, url, title, Icon, qrSvg }) =>
          qrSvg && Icon !== undefined ? (
            <>
              <button
                type="button"
                popovertarget={`share-${name}`}
                class="group hover:text-accent inline-flex cursor-pointer items-center gap-1 p-2 hover:rotate-6 sm:p-1"
                title={title}
              >
                <Icon class="inline-block size-5 fill-current opacity-90" />
                <span class="sr-only">{title}</span>
              </button>
              <div
                id={`share-${name}`}
                popover
                class="border-border bg-background text-foreground m-auto rounded border p-4 text-center backdrop:bg-black/40"
              >
                <div class="mx-auto size-48 bg-white" set:html={qrSvg} />
                <p class="mt-2 text-sm">Scan with WeChat to share</p>
              </div>
            </>
          ) : Icon ? (
            <LinkButton
              href={`${url}${pageUrl}`}
              class="p-2 hover:rotate-6 sm:p-1"
              title={title}
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon class="inline-block size-5 fill-current opacity-90" />
              <span class="sr-only">{title}</span>
            </LinkButton>
          ) : null
        )}
      </div>
    </div>
  )
}
