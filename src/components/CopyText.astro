---
type Props = {
  text: string;
  /** What lands on the clipboard; defaults to the displayed text. */
  value?: string;
};

const { text, value = text } = Astro.props;
---

<button
  type="button"
  data-copy-text={value}
  title="Click to copy"
  aria-label={`Copy ${value}`}
  class="hover:text-accent cursor-pointer font-medium underline decoration-dashed underline-offset-4 transition-colors"
  >{text}</button
>

<script>
  document.addEventListener("click", async event => {
    if (!(event.target instanceof Element)) return;
    const button = event.target.closest<HTMLButtonElement>("[data-copy-text]");
    if (!button || button.dataset.copied) return;

    const label = button.textContent;
    const value = button.dataset.copyText ?? "";
    button.dataset.copied = "true";
    let copied = false;
    try {
      await navigator.clipboard.writeText(value);
      copied = true;
    } catch {
      // Report denied or unavailable clipboard access with the same feedback below.
    }

    button.textContent = copied ? "Copied!" : "Copy failed";
    setTimeout(() => {
      button.textContent = label;
      delete button.dataset.copied;
    }, 1200);
  });
</script>
