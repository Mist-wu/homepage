---
import config from "@/config";
import LinkButton from "./LinkButton.astro";

const { site, socials } = config;

const icons = import.meta.glob<{
  default: (_props: Record<string, unknown>) => unknown;
}>("/src/assets/icons/socials/*.svg");

const platformLabels: Record<string, string> = {
  github: "GitHub",
  wechat: "WeChat",
};

const items = await Promise.all(
  socials.map(async ({ name, url, linkTitle }) => {
    const mod = await icons[`/src/assets/icons/socials/${name}.svg`]?.();
    const Icon = mod?.default;
    const platform =
      platformLabels[name] ?? name.charAt(0).toUpperCase() + name.slice(1);
    const title =
      linkTitle ??
      (url.startsWith("mailto:") || name === "mail"
        ? `Send an email to ${site.title}`
        : `${site.title} on ${platform}`);
    return { name, url, title, Icon };
  })
);

const iconClass = "inline-block size-5 fill-current opacity-90";
---

<div class="flex flex-wrap items-center gap-1">
  {
    items.map(({ name, url, title, Icon }) =>
      Icon === undefined ? null : name === "wechat" ? (
        // WeChat has no profile URL; url is a QR code image shown on hover/focus
        <span class="group/qr relative inline-flex">
          <button
            type="button"
            class="group hover:text-accent inline-flex cursor-pointer items-center gap-1 p-2 hover:rotate-6 sm:p-1"
            aria-label={title}
          >
            <Icon class={iconClass} />
          </button>
          <span class="border-border bg-background pointer-events-none absolute bottom-full left-1/2 z-10 mb-2 hidden w-44 -translate-x-1/2 rounded border p-2 shadow-lg group-focus-within/qr:block group-hover/qr:block">
            <img
              src={url}
              alt={`${site.title}'s WeChat QR code`}
              class="w-full rounded-sm"
            />
          </span>
        </span>
      ) : (
        <LinkButton href={url} class="p-2 hover:rotate-6 sm:p-1" title={title}>
          <Icon class={iconClass} />
          <span class="sr-only">{title}</span>
        </LinkButton>
      )
    )
  }
</div>
