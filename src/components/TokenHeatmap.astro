---
/**
 * GitHub-style contribution graph of daily AI token usage over the last year.
 *
 * Data: src/data/token-usage.json is generated by `pnpm sync:tokens`;
 * src/data/token-usage.overrides.json holds hand edits and wins per day.
 */
import generated from "@/data/token-usage.json";
import overrides from "@/data/token-usage.overrides.json";
import config from "@/config";

const usage: Record<string, number> = { ...generated, ...overrides };

const WEEKS = 53;
const DAY_MS = 86_400_000;

const toKey = (date: Date) => date.toISOString().slice(0, 10);

// Dates are handled as UTC midnights so day math never crosses a DST edge;
// "today" is taken in the site's timezone.
const todayKey = new Intl.DateTimeFormat("en-CA", {
  timeZone: config.site.timezone,
}).format(new Date());
const today = new Date(`${todayKey}T00:00:00Z`);
const start = new Date(
  today.getTime() - (today.getUTCDay() + (WEEKS - 1) * 7) * DAY_MS
);

const days = Array.from({ length: WEEKS * 7 }, (_, i) => {
  const date = new Date(start.getTime() + i * DAY_MS);
  const key = toKey(date);
  return { date, key, tokens: usage[key] ?? 0, future: date > today };
});

// Quartiles of the active days decide the four shades, like GitHub does.
const active = days
  .map(day => day.tokens)
  .filter(tokens => tokens > 0)
  .sort((a, b) => a - b);
const thresholds = [0.25, 0.5, 0.75].map(
  q => active[Math.floor(q * active.length)] ?? Infinity
);
const levelOf = (tokens: number) =>
  tokens <= 0 ? 0 : 1 + thresholds.filter(t => tokens >= t).length;

const compact = new Intl.NumberFormat("en", {
  notation: "compact",
  maximumFractionDigits: 1,
});
const longDate = new Intl.DateTimeFormat("en", {
  dateStyle: "medium",
  timeZone: "UTC",
});
const shortMonth = new Intl.DateTimeFormat("en", {
  month: "short",
  timeZone: "UTC",
});

const total = active.reduce((sum, tokens) => sum + tokens, 0);

// Label a column when its week starts a new month (skipping the first column
// if the next one would immediately replace it).
const months = Array.from({ length: WEEKS }, (_, week) => {
  const month = days[week * 7].date.getUTCMonth();
  const prev = week > 0 ? days[(week - 1) * 7].date.getUTCMonth() : -1;
  const next =
    week < WEEKS - 1 ? days[(week + 1) * 7].date.getUTCMonth() : month;
  if (month === prev || (week === 0 && next !== month)) return "";
  return shortMonth.format(days[week * 7].date);
});
---

<div class="token-heatmap">
  <p class="text-muted-foreground mb-3 text-sm">
    {compact.format(total)} tokens in the last year
  </p>

  {/* rtl scroller so narrow screens start at the most recent weeks */}
  <div class="overflow-x-auto pb-2" dir="rtl">
    <div class="min-w-[640px]" dir="ltr">
      <div class="months text-muted-foreground mb-1 text-xs" aria-hidden="true">
        {months.map(label => <span>{label}</span>)}
      </div>
      <div class="cells" role="img" aria-label="Daily AI token usage heatmap">
        {
          days.map(day =>
            day.future ? (
              <span />
            ) : (
              <span
                class="cell"
                data-level={levelOf(day.tokens)}
                data-tip={`${
                  day.tokens > 0
                    ? `${compact.format(day.tokens)} tokens`
                    : "No usage"
                } on ${longDate.format(day.date)}`}
              />
            )
          )
        }
      </div>
    </div>
  </div>

  <div
    class="text-muted-foreground mt-1 flex items-center justify-end gap-1 text-xs"
    aria-hidden="true"
  >
    <span class="me-1">Less</span>
    {
      [0, 1, 2, 3, 4].map(level => (
        <span class="cell legend" data-level={level} />
      ))
    }
    <span class="ms-1">More</span>
  </div>
  <div class="tip" role="tooltip" hidden></div>
</div>

<script>
  // One shared tooltip, shown instantly on hover (or tap) of a day cell.
  let tip: HTMLElement | null = null;

  function show(cell: HTMLElement) {
    tip = cell.closest(".token-heatmap")?.querySelector(".tip") ?? null;
    if (!tip) return;
    tip.textContent = cell.dataset.tip ?? "";
    tip.hidden = false;

    const rect = cell.getBoundingClientRect();
    const half = tip.offsetWidth / 2;
    const center = rect.left + rect.width / 2;
    const left = Math.min(
      Math.max(center, half + 8),
      window.innerWidth - half - 8
    );
    tip.style.left = `${left}px`;
    tip.style.top = `${rect.top - 6}px`;
  }

  function hide() {
    if (tip) tip.hidden = true;
  }

  document.addEventListener("pointerover", event => {
    const cell = (event.target as Element).closest<HTMLElement>(
      ".token-heatmap [data-tip]"
    );
    if (cell) show(cell);
    else hide();
  });
  document.addEventListener("scroll", hide, { capture: true, passive: true });
</script>

<style>
  .tip {
    position: fixed;
    z-index: 50;
    transform: translate(-50%, -100%);
    padding: 0.25rem 0.5rem;
    border-radius: 0.375rem;
    background: var(--foreground);
    color: var(--background);
    font-size: 0.75rem;
    line-height: 1rem;
    white-space: nowrap;
    pointer-events: none;
  }

  .tip[hidden] {
    display: none;
  }

  .months,
  .cells {
    display: grid;
    grid-template-columns: repeat(53, minmax(0, 1fr));
    gap: 3px;
  }

  .months span {
    white-space: nowrap;
    overflow: visible;
    width: 0;
  }

  .cells {
    grid-template-rows: repeat(7, auto);
    grid-auto-flow: column;
  }

  .cell {
    aspect-ratio: 1;
    border-radius: 2px;
    background: color-mix(in srgb, var(--muted) 55%, transparent);
  }

  .cell.legend {
    width: 11px;
  }

  .cell[data-tip]:hover {
    outline: 1px solid var(--foreground);
  }

  .cell[data-level="1"] {
    background: color-mix(in srgb, var(--accent) 30%, var(--background));
  }

  .cell[data-level="2"] {
    background: color-mix(in srgb, var(--accent) 55%, var(--background));
  }

  .cell[data-level="3"] {
    background: color-mix(in srgb, var(--accent) 78%, var(--background));
  }

  .cell[data-level="4"] {
    background: var(--accent);
  }
</style>
